{
  "name": "apex-management-studio-5-preview",
  "version": "5.0.0-preview.1",
  "description": "Isolated demo preview of APEX Management Studio 5 (Concept A) — no production cloud writes",
  "main": "src/main.js",
  "author": "APEX Inventory Studio",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test:pallet-locations": "node --test tests/pallet-locations.test.js",
    "pack:windows": "electron-builder --win nsis",
    "pack:portable": "electron-builder --win portable --config.win.artifactName=APEX-Management-Studio-5-Preview-Portable-${version}.${ext}",
    "prepack:windows": "node scripts/configure-distribution-login.js --check",
    "prepack:portable": "node scripts/configure-distribution-login.js --check"
  },
  "dependencies": {
    "@zxing/browser": "0.2.1",
    "@zxing/library": "^0.23.0",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.apex.management.preview5",
    "productName": "APEX Management Studio 5 Preview",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "hub/**/*.js",
      "package.json",
      "node_modules/@zxing/**/*",
      "node_modules/@zxing/browser/**/*",
      "cloud/sync-bridge.js",
      "cloud/refurb-parts-bridge.js",
      "cloud/hub-diagnostics-reentry.js"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "APEX-Management-Studio-5-Preview-Setup-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "icon": "build/icon.png",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "APEX Management Studio 5 Preview",
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "from": "tools/update-centre-v2/INSTALL-PORTABLE-UPDATE.ps1",
        "to": "updater/INSTALL-PORTABLE-UPDATE.ps1"
      }
    ]
  }
}
